# The Curtain Guy Supabase — server only
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The Curtain Guy Resend — server only
RESEND_API_KEY=

# Estimate notification settings
TCG_ESTIMATE_NOTIFY_TO=admin@thecurtainguy.com
TCG_ESTIMATE_FROM=The Curtain Guy <onboarding@resend.dev>
TCG_QUOTE_FROM=
TCG_SEND_CUSTOMER_CONFIRMATION=true

# Public browser auth (publishable / anon key — not the service role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public site URL
NEXT_PUBLIC_SITE_URL=https://thecurtainguy.com

# Local setup note:
# Copy this file to .env.local and fill real values.
# After auth/uploads migration, also set the NEXT_PUBLIC_SUPABASE_* keys
# from The Curtain Guy Supabase → Project Settings → API.
